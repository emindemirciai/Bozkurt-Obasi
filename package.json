{
  "name": "bozkurt-obasi",
  "version": "1.5.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Bozkurt Obası: Ay-Yıldız Nöbeti — browser village builder and crescent formation defense",
  "homepage": "https://bozkurtobasi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emindemirciai/Bozkurt-Obasi.git"
  },
  "bugs": {
    "url": "https://github.com/emindemirciai/Bozkurt-Obasi/issues"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/web/index.mjs",
    "build": "vite build",
    "build:preview": "node scripts/build-preview.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/web/index.mjs",
    "check": "node scripts/check.mjs",
    "format": "prettier --write web shared server/web scripts tests vite.config.mjs playwright.config.mjs index.html",
    "format:check": "prettier --check web shared server/web scripts tests vite.config.mjs playwright.config.mjs index.html",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "count:lines": "node scripts/count-lines.mjs",
    "backup": "node scripts/backup.mjs",
    "release:version": "node scripts/release-version.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:check": "node scripts/release-version.mjs check",
    "verify": "npm run check && npm test && npm run build && npm run build:preview && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.8",
    "vite": "8.3.0"
  },
  "dependencies": {
    "nodemailer": "10.0.13"
  }
}
