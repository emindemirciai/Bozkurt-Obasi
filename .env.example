HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/game.sqlite
STATIC_DIR=./dist
TRUST_PROXY=false

# Public identity and absolute base URL for verification links.
PUBLIC_URL=https://bozkurtobasi.com
CONTACT_EMAIL=info@bozkurtobasi.com

# Optional verification email delivery. Without SMTP_PASSWORD, no real mail is sent.
# MAIL_FROM may change the display name, but its address must remain info@bozkurtobasi.com.
# SMTP_USER is only the SMTP login, separate from ADMIN_EMAIL.
# Hostinger settings use port 465 + implicit TLS (true); port 587 uses STARTTLS (false).
# Never commit SMTP_PASSWORD or relax certificate validation.
MAIL_PROVIDER=smtp
MAIL_FROM="Bozkurtobasi.com <info@bozkurtobasi.com>"
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@bozkurtobasi.com
SMTP_PASSWORD=

# Game-side runtime analytics. Local/file previews do not send traffic.
# Other ANALYZE_* values configure the bundled analyze service in compose.yml.
ANALYZE_ENABLED=false
ANALYZE_URL=https://analiz.bozkurtobasi.com
ANALYZE_SITE_ID=bozkurtobasi.com
ANALYZE_ALLOWED_ORIGINS=https://bozkurtobasi.com,https://www.bozkurtobasi.com

# Shared administrator credentials for admin and analytics platform-admin login.
# Set ADMIN_PASSWORD only in Dokploy; at least 12 characters. Never commit a real value.
ADMIN_EMAIL=info@bozkurtobasi.com
ADMIN_PASSWORD=

# Four-service Compose analytics panel defaults (see compose.yml).
ANALYZE_SITE_NAME=Bozkurtobasi.com
ANALYZE_TITLE_TR=Bozkurtobasi.com Siteni Analiz Et
ANALYZE_TITLE_EN=Bozkurtobasi.com Analyze Your Site
ANALYZE_METADATA_TITLE=Bozkurtobasi.com Siteni Analiz Et | Trafik Paneli
ANALYZE_DESCRIPTION=Bozkurtobasi.com için gerçek zamanlı trafik analiz paneli
ANALYZE_HEALTH_NAME=Bozkurtobasi.com Siteni Analiz Et
ANALYZE_AUTH_MODE=platform-admin
ANALYZE_AUTH_API_URL=https://api.bozkurtobasi.com
ANALYZE_EVENT_SITES=bozkurtobasi.com,www.bozkurtobasi.com
ANALYZE_DATA_DIR=/app/data
ANALYZE_MAX_EVENTS=200000
ANALYZE_GEO_LOOKUP=true
