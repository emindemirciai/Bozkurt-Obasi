############################################
# BOZKURT OBASI - DOKPLOY PRODUCTION
# Copy values into Dokploy Environment; this file contains no real secrets.
# Bu örnekte gerçek parola yoktur. Parolayı yalnızca Dokploy Environment'a yazın.
############################################

# ADMIN / YONETIM
# Login address shown in the user's example. Without this key, Compose defaults to info@bozkurtobasi.com.
ADMIN_EMAIL=emindemirci.ai@gmail.com
# ## REQUIRED for admin + analytics login: generate a strong, unique secret of at least 12 characters. ##
# ZORUNLU: en az 12 karakterlik guclu, benzersiz parola uretin. Bosken admin_unavailable (503) doner.
# Keep the placeholder on a separate comment line. Compose 5.5.1 treats an inline # after an empty value as literal text.
# Parola bilgisini bu satirin yerine Dokploy'da girin; bir # notunu deger olarak kullanmayin.
ADMIN_PASSWORD=

# VERIFICATION EMAIL / DOGRULAMA E-POSTASI
# All outgoing messages use info@bozkurtobasi.com as From; MAIL_FROM controls display name only.
# SMTP_USER is the provider login and may differ from the From address; configure the
# provider to authorize sending for info@bozkurtobasi.com (SPF/DKIM/DMARC recommended).
# Fill SMTP_PASSWORD only in Dokploy. Without it, real mail is not sent.
# Hostinger 465 uses implicit TLS (true); 587 uses STARTTLS (false). Keep TLS validation enabled.
PUBLIC_URL=https://bozkurtobasi.com
MAIL_PROVIDER=smtp
MAIL_FROM="Bozkurtobasi.com <info@bozkurtobasi.com>"
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@bozkurtobasi.com
SMTP_PASSWORD=

# GOOGLE SIGN-IN / GOOGLE ILE GIRIS
# OPTIONAL / ISTEGE BAGLI. Email/password sign-in works without Google credentials.
# Create a Web application OAuth client in Google Cloud for bozkurtobasi.com.
# Authorized redirect URIs must match the comma-separated values below exactly.
# Never put the client secret in Git, ZIP, or browser code; set it in Dokploy Environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URIS=https://bozkurtobasi.com/api/auth/google/callback,https://www.bozkurtobasi.com/api/auth/google/callback
# GAME -> ANALYTICS / OYUN -> ANALIZ
ANALYZE_ENABLED=true
ANALYZE_URL=https://analiz.bozkurtobasi.com
ANALYZE_SITE_ID=bozkurtobasi.com
ANALYZE_ALLOWED_ORIGINS=https://bozkurtobasi.com,https://www.bozkurtobasi.com

# BUNDLED ANALYTICS PANEL / TUMLESIK ANALIZ PANELI
ANALYZE_SITE_NAME=Bozkurtobasi.com
ANALYZE_TITLE_TR=Bozkurtobasi.com Siteni Analiz Et
ANALYZE_TITLE_EN=Bozkurtobasi.com Analyze Your Site
ANALYZE_METADATA_TITLE=Bozkurtobasi.com Siteni Analiz Et | Trafik Paneli
ANALYZE_DESCRIPTION=Bozkurtobasi.com için gerçek zamanlı trafik analiz paneli
ANALYZE_HEALTH_NAME=Bozkurtobasi.com Siteni Analiz Et
ANALYZE_AUTH_API_URL=https://api.bozkurtobasi.com
ANALYZE_EVENT_SITES=bozkurtobasi.com,www.bozkurtobasi.com
ANALYZE_MAX_EVENTS=200000
ANALYZE_GEO_LOOKUP=true

# NODE_ENV=production, ANALYZE_AUTH_MODE=platform-admin and ANALYZE_DATA_DIR=/app/data
# are fixed in compose.yml, so they are not repeatable Dokploy inputs here.
